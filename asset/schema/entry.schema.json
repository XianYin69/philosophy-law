{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "哲学法律知识条目",
  "type": "object",
  "required": ["id", "title", "domain", "refs", "verified"],
  "properties": {
    "id": {"type": "string", "pattern": "^(law|phil|reason)\\.[a-z0-9_.-]+$"},
    "title": {"type": "string"},
    "domain": {"enum": ["law", "philosophy", "reasoning"]},
    "source": {"type": "string"},
    "article": {"type": "string"},
    "era": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "force_status": {"enum": ["现行", "被修订", "已废", "历史法源", "待核"]},
    "gist": {"type": "string"},
    "text": {"type": "string"},
    "thesis": {"type": "string"},
    "school": {"type": "string"},
    "criticism": {"type": "array", "items": {"type": "object",
      "required": ["by", "claim"], "properties": {
        "by": {"type": "string"}, "claim": {"type": "string"}}}},
    "steps": {"type": "array", "items": {"type": "string"}},
    "must_answer": {"type": "array", "items": {"type": "string"}},
    "grade_scale": {"type": "array", "items": {"type": "string"}},
    "refs": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["tier"], "properties": {
        "tier": {"enum": ["T1", "T2", "T3", "T4"]},
        "url": {"type": "string"}, "citation": {"type": "string"}}}},
    "verified": {"enum": ["yes", "partial", "no"]},
    "last_checked": {"type": "string"},
    "degraded": {"type": "string"},
    "related": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"domain": {"const": "law"}}},
     "then": {"required": ["source", "article", "era", "jurisdiction",
                           "force_status", "gist"]}},
    {"if": {"properties": {"domain": {"const": "philosophy"}}},
     "then": {"required": ["text", "thesis", "school", "criticism"]}}
  ]
}
